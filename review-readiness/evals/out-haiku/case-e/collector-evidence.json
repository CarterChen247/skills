    {
      "path": "src/orders/events/handlers/handler01.ts",
      "start_line": 1,
      "excerpt": "import type { OrderEvent, OrderProjection } from \"../../types\";\n\n// OrderPlaced → initial projection\nexport function onOrderPlaced(state: OrderProjection | undefined, e: OrderEvent<\"OrderPlaced\">): OrderProjection {\n  return { id: e.orderId, status: \"placed\", items: e.items, total: e.total, version: (state?.version ?? 0) + 1 };\n}"
    },
    {
      "path": "src/orders/events/handlers/handler02.ts",
      "start_line": 1,
      "excerpt": "import type { OrderEvent, OrderProjection } from \"../../types\";\n\n// OrderPaid → status paid\nexport function onOrderPaid(state: OrderProjection, e: OrderEvent<\"OrderPaid\">): OrderProjection {\n  if (state.status !== \"placed\") return state;\n  return { ...state, status: \"paid\", paidAt: e.at, version: state.version + 1 };\n}"
    }
  ],
