@@ -12,18 +12,40 @@ import { db } from "../db";
-export async function sendNotification(userId: number, msg: Message) {
-  await push.send(userId, msg);
-  await email.send(userId, msg);
-}
+export async function sendNotification(userId: number, msg: Message) {
+  const prefs = await prefsService.get(userId);
+  if (prefs.pushEnabled && !inQuietHours(prefs, new Date())) {
+    await push.send(userId, msg);
+  }
+  if (prefs.emailDigest === "off" || msg.urgent) {
+    await email.send(userId, msg);
+  } else {
+    await digestQueue.enqueue(userId, msg);
+  }
+}
+
+export function inQuietHours(p: Prefs, now: Date): boolean {
+  if (p.quietStart == null || p.quietEnd == null) return false;
+  const h = now.getUTCHours();
+  return p.quietStart <= p.quietEnd ? h >= p.quietStart && h < p.quietEnd : h >= p.quietStart || h < p.quietEnd;
+}
