+// Runs hourly. Sends queued digest emails for users whose digest window is due.
+export async function runDigest(now = new Date()) {
+  const due = await digestQueue.dueUsers(now);
+  for (const userId of due) {
+    const items = await digestQueue.drain(userId);
+    if (items.length) await email.sendDigest(userId, items);
+  }
+}
