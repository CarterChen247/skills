diff --git a/src/api/notificationPrefs.ts b/src/api/notificationPrefs.ts
new file mode 100644
--- /dev/null
+++ b/src/api/notificationPrefs.ts
@@ -0,0 +1,40 @@
+import { Router } from "express";
+import { requireUser } from "../auth/requireUser";
+import { prefsService } from "../services/notificationService";
+
+export const notificationPrefsRouter = Router();
+
+notificationPrefsRouter.get("/me/notification-prefs", requireUser, async (req, res) => {
+  const prefs = await prefsService.get(req.user.id);
+  res.json(prefs);
+});
+
+notificationPrefsRouter.put("/me/notification-prefs", requireUser, async (req, res) => {
+  const { emailDigest, pushEnabled, quietStart, quietEnd } = req.body ?? {};
+  if (emailDigest && !["off", "daily", "weekly"].includes(emailDigest)) {
+    return res.status(400).json({ error: "invalid emailDigest" });
+  }
+  if (quietStart != null && (quietStart < 0 || quietStart > 23)) {
+    return res.status(400).json({ error: "invalid quietStart" });
+  }
+  if (quietEnd != null && (quietEnd < 0 || quietEnd > 23)) {
+    return res.status(400).json({ error: "invalid quietEnd" });
+  }
+  const updated = await prefsService.update(req.user.id, { emailDigest, pushEnabled, quietStart, quietEnd });
+  res.json(updated);
+});
diff --git a/src/services/notificationService.ts b/src/services/notificationService.ts
