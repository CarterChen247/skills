+export async function transfer(from: string, to: string, amount: number, idemKey?: string) {
+  if (amount <= 0) throw new InvalidAmount();
+  return withSerializableRetry(async (tx) => {
+    const [a, b] = [from, to].sort();
+    const locked = await tx.query("SELECT id, balance FROM accounts WHERE id IN ($1,$2) ORDER BY id FOR UPDATE", [a, b]);
+    const src = locked.find((r) => r.id === from);
+    if (!src) throw new UnknownAccount(from);
+    if (src.balance < amount) throw new InsufficientFunds();
+    await tx.accounts.debit(from, amount);
+    await tx.accounts.credit(to, amount);
+    await notifyTransfer(from, to, amount); // emits webhook to partner
+    return { ok: true };
+  }, { maxAttempts: 5 });
+}
